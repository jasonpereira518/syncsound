# ---- Server (apps/server) ----
# `pnpm dev` ports: SERVER_PORT (server, also used by the web app's default URL) and WEB_PORT (Next.js)
# SERVER_PORT=8787
# WEB_PORT=3000
PORT=8787
# Where uploaded + demo assets live in dev
DATA_DIR=./data
# Comma-separated allowed browser origins for CORS/WS (empty = allow all, dev only)
ALLOWED_ORIGINS=
# Rooms with no connected devices expire after this many minutes
ROOM_TTL_MINUTES=60
# Optional S3-compatible storage (R2/MinIO). If S3_BUCKET is empty, local disk is used.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- Web (apps/web) ----
# Defaults to ws(s)://<page host>:8787 and http(s)://<page host>:8787 when unset (local / LAN only).
# REQUIRED on a public deployment (Vercel): the room server's URL, e.g. https://syncsound-server.onrender.com
NEXT_PUBLIC_SERVER_URL=

# Spotify (Class B, sync-only). Needs a Spotify app with the Web Playback SDK enabled;
# every participating device needs its own Premium account. Leave empty to disable.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
# Must be registered in the Spotify dashboard, e.g. http://127.0.0.1:3000/spotify-callback
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=

# Apple Music (Class B, sync-only). A MusicKit developer token (JWT signed with your MusicKit key).
# Every participating device needs its own Apple Music subscription. Leave empty to disable.
NEXT_PUBLIC_APPLE_MUSIC_DEVELOPER_TOKEN=
NEXT_PUBLIC_APPLE_MUSIC_APP_NAME=SyncSound
