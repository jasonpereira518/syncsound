{
  "name": "syncsound",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @syncsound/server --filter @syncsound/web dev",
    "demo": "tsx scripts/demo.ts",
    "render:speakers": "tsx scripts/render-speakers.ts",
    "test": "pnpm -r --filter=!@syncsound/sim --if-present test",
    "sim": "pnpm --filter @syncsound/sim test",
    "e2e": "playwright test",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm sim && pnpm demo && pnpm e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "three": "0.170.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
